POSTGRES_PASSWORD=change-me
PAPER_API_KEY=replace-with-a-long-random-local-secret
# live = wall clock; replay = data clock (historical bars). Never mix on one portfolio.
PAPER_CLOCK=live
# optional overrides (validated at start; see GET /config):
# PAPER_SWEEP_INTERVAL_SEC=30
# MAX_BODY_BYTES=33554432
# AUTH_FAIL_LIMIT=10
# AUTH_FAIL_WINDOW_SEC=60
# DB_STATEMENT_TIMEOUT_MS=10000
# chain ingestion (python -m app.chain): never commit a real URL, it usually contains an API key
# CHAIN_RPC_URL=

